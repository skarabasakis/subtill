<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="subtill"
        Arguments=""
        InstallLocation="C:\Program Files\Anodic\subtill">
    </Installer>
    <PackageInformation
        PackageName="subtill"
        PackageDisplayName="subtill"
        PublisherName="CN=Anodic"
        PublisherDisplayName="Anodic"
        Version="0.1.0.0"
        PackageDescription="Local subscription manager">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.anodic.subtill"
                Description="Local subscription manager"
                DisplayName="subtill"
                ExecutableName="subtill"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>subtill</DisplayName>
            <PublisherDisplayName>Anodic</PublisherDisplayName>
            <Description>Local subscription manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="subtill.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
